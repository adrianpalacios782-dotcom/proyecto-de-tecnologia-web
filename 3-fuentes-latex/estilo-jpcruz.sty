% Banner de misión: \misionbanner{numero}{titulo}{duracion}{objetivo}
\newcommand{\misionbanner}[4]{%
  \par\needspace{15\baselineskip}\vspace{4mm}\noindent
  \begin{tikzpicture}
    \fill[rounded corners=4mm,term] (0,0) rectangle (\linewidth,2.45);
    \foreach \r in {0.5,1.0,1.5,2.0}{\draw[cianjp!45,line width=0.4pt] (\linewidth-1.3cm,1.22) circle (\r*0.5);}
    \fill[verdejp!80,opacity=0.35] (\linewidth-1.3cm,1.22) -- ++(15:1) arc (15:60:1) -- cycle;
    \node[anchor=north west,text=cianjp!70!white,font=\ttfamily\small] at (0.45,2.2) {MISIÓN #1 \quad·\quad #3};
    \node[anchor=north west,text=white,font=\sffamily\bfseries\LARGE] at (0.42,1.72) {#2};
    \node[anchor=north west,text=termtx,font=\sffamily\small,text width=0.8\linewidth,align=left] at (0.45,1.0) {#4};
  \end{tikzpicture}\par\vspace{2mm}}

